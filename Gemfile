source "https://rubygems.org"

# GitHub Pages builds this site with its own pinned toolchain, so nothing here
# is required for deploys. It exists so `bundle exec jekyll serve` reproduces
# that toolchain locally.
gem "github-pages", group: :jekyll_plugins

# Windows / JRuby bits that Jekyll wants but ships without.
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]
gem "wdm", "~> 0.1", platforms: [:mingw, :mswin, :x64_mingw]
